{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:opentrace:schema:authorization:request:1",
  "title": "WhatsApp Traceability Research Lab trace request envelope (technical policy input only)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id",
    "case_id",
    "protocol_id",
    "target_ref",
    "disclosure_mode",
    "purpose",
    "legal_basis_ref",
    "requested_at",
    "expires_at",
    "request_version",
    "scope",
    "policy_id"
  ],
  "properties": {
    "request_version": {
      "const": "1"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "protocol_id": {
      "type": "string",
      "minLength": 1
    },
    "target_ref": {
      "type": "string",
      "minLength": 1
    },
    "disclosure_mode": {
      "enum": [
        "ORIGIN_ONLY",
        "PATH",
        "TREE"
      ]
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "legal_basis_ref": {
      "type": "string",
      "minLength": 1,
      "description": "Reference only; the software does not validate legal sufficiency."
    },
    "requested_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "synthetic_only": {
      "type": "boolean"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset_refs",
        "message_ref_only",
        "include_intermediate_recipients"
      ],
      "properties": {
        "dataset_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "maxItems": 1000,
          "uniqueItems": true
        },
        "message_ref_only": {
          "type": "boolean"
        },
        "include_intermediate_recipients": {
          "type": "boolean"
        }
      }
    },
    "policy_id": {
      "type": "string",
      "minLength": 1
    }
  }
}
